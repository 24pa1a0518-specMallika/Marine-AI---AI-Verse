# Frontend Environment Variables Template
# Copy this file to .env for local development

# Base URL for the Express Backend API (Port 5000)
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Firebase Authentication & Firestore Configuration
# If omitted or left empty, the frontend operates in seamless local auth mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# IMPORTANT SECURITY NOTE:
# Do NOT place API secrets (e.g. GEMINI_API_KEY, WEATHER_API_KEY, DATABASE_URL) in this file.
# Secret API keys must remain strictly on the backend server.
